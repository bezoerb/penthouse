{
  "name": "penthouse",
  "description": "Generate critical path CSS for web pages",
  "version": "2.3.3",
  "homepage": "https://github.com/pocketjoso/penthouse",
  "author": {
    "name": "Jonas Ohlsson Aden",
    "email": "jonas.sebastian.ohlsson@gmail.com",
    "url": "https://jonassebastianohlsson.com"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/pocketjoso/penthouse.git#master"
  },
  "bugs": {
    "url": "https://github.com/pocketjoso/penthouse/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js"
    }
  },
  "engines": {
    "node": ">=18.14.0"
  },
  "scripts": {
    "lint": "oxlint src",
    "test": "vitest run test/core.test.js",
    "test-all": "vitest run test/*.test.js && yarn test-extra && yarn test-perf",
    "test-perf": "vitest run test/run-sequential/perf.test.js",
    "test-extra": "vitest run test/run-sequential/node-module.test.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.js": [
      "prettier-standard"
    ]
  },
  "dependencies": {
    "css-mediaquery": "^0.1.2",
    "css-tree": "3.1.0",
    "debug": "^4.4.3",
    "exit-hook": "^4.0.0",
    "jsesc": "^3.1.0",
    "puppeteer": "^24.22.3"
  },
  "devDependencies": {
    "gm": "^1.25.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.0",
    "oxlint": "^1.18.0",
    "prettier": "^3.6.2",
    "prettier-standard": "^16.4.1",
    "rimraf": "^6.0.1",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "CSS Critical Path Generator",
    "css",
    "performance",
    "build",
    "tool",
    "chrome:headless"
  ],
  "files": [
    "src"
  ]
}
